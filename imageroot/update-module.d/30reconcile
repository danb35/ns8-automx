#
# Re-apply routes after an update: 20restart re-renders automx.conf, but
# only reconcile() creates or changes routes, so a release that changes
# them (0.2.0 added the capitalized Autodiscover route) would otherwise
# reach an existing instance only at its next save. Runs after 20restart,
# so reload-automx finds the render unchanged and does not restart again.

import os
import sys

sys.path.insert(0, os.path.join(os.environ["AGENT_INSTALL_DIR"], "pypkg"))

import agent
from automx import reconcile

rdb = agent.redis_connect(use_replica=True)
reconcile.reconcile(rdb)
