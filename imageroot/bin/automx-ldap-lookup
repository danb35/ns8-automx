#!/usr/bin/env python3
#
# Copyright (C) 2026 Dan Brown
# SPDX-License-Identifier: GPL-3.0-or-later
#
# automx "script" backend lookup helper. Runs INSIDE the automx-app
# container (baked into the image by the Containerfile), invoked by automx
# itself as a plain subprocess -- not by the NS8 agent framework, so no
# "agent" module is available here, only the stdlib and python-ldap.
#
# Contract (DESIGN.md 3.3, "script backend contract"):
#   argv:   automx-ldap-lookup <local-part> <domain> <email-address>
#   stdout: exactly one line "<login>|<display_name>", always, even on a
#           miss or an LDAP error -- automx has no distinct "miss" signal
#           separate from "crash" (any nonzero exit is fatal to the
#           client's request), so falling back has to happen in here.
#   exit:   always 0. A nonzero exit is reserved for "this script itself is
#           broken", since automx cannot tell that apart from a lookup miss.
#
# Connection parameters (ldapproxy endpoint, bind credentials, base DN,
# schema, the hidden-users filter clause) are rendered on the host by
# imageroot/bin/render-automx-conf, which has access to the NS8 agent SDK
# and Ldapproxy() that this script does not; they arrive here as a
# read-only, per-instance JSON file (DESIGN.md 3.3/4.2 -- not backed up,
# regenerated on every render, same as automx.conf itself).

import json
import os
import sys

CONFIG_PATH = os.environ.get(
    "AUTOMX_LDAP_LOOKUP_CONFIG", "/etc/automx/ldap-lookup.json"
)
# {"alias@domain": "login"}, written on the host by refresh-aliases
# (automx/aliases.py). Optional: absent or unreadable means no aliases.
ALIASES_PATH = os.environ.get(
    "AUTOMX_ALIASES", "/etc/automx/aliases/aliases.json"
)

# rfc2307 (OpenLDAP) vs ad (Samba AD) attribute mapping -- DESIGN.md 3.3.
# "names" is tried in order. NS8's OpenLDAP keeps the full name in
# displayName, as ns8-core's own agent/ldapclient/rfc2307.py reads it; its
# cn holds only the first part of the name (with a trailing newline), so
# cn is only a fallback for entries without displayName. Found on a real
# node, 2026-09-29: "Test User" was published as "Test".
ATTR_MAP = {
    "rfc2307": {"login": "uid", "mail": "mail", "names": ("displayName", "cn")},
    "ad": {"login": "sAMAccountName", "mail": "mail", "names": ("displayName",)},
}

LDAP_TIMEOUT_SECONDS = 5


def emit(login, display_name=""):
    # separator = "|" in automx.conf (DESIGN.md 3.3) -- a display name can
    # contain a space, so the default whitespace split would break it.
    # A literal "|" in a display name would break the split the other way,
    # so it's stripped rather than escaped (automx's script backend has no
    # escaping mechanism of its own). Line breaks would end the one output
    # line early, so they become spaces.
    display_name = " ".join(display_name.replace("|", "").split())
    print(f"{login}|{display_name}")


def fallback(email_address):
    emit(email_address)


def alias_login(email_address):
    """The login an alias delivers to, or None."""
    try:
        with open(ALIASES_PATH, encoding="utf-8") as f:
            alias_map = json.load(f)
        login = alias_map.get(email_address.lower())
    except Exception:
        return None
    return login if isinstance(login, str) and login else None


def lookup(local_part, domain, email_address, aliased=False):
    """(login, display_name) of the matching entry, or None. With aliased,
    local_part is already the alias owner's login, so only the login
    attribute is matched: the alias address itself is not in LDAP."""
    with open(CONFIG_PATH, encoding="utf-8") as f:
        config = json.load(f)

    import ldap
    import ldap.filter

    attrs = ATTR_MAP[config["schema"]]

    conn = ldap.initialize(f"ldap://{config['host']}:{config['port']}")
    conn.set_option(ldap.OPT_NETWORK_TIMEOUT, LDAP_TIMEOUT_SECONDS)
    conn.set_option(ldap.OPT_TIMEOUT, LDAP_TIMEOUT_SECONDS)
    conn.set_option(ldap.OPT_REFERRALS, 0)
    try:
        conn.simple_bind_s(config["bind_dn"], config["bind_password"])

        # Lookup rule (DESIGN.md 3.3): an entry whose login attribute equals
        # the local part (covers "dan@domain" and bare "dan"), else an entry
        # whose mail attribute equals the full address.
        local_esc = ldap.filter.escape_filter_chars(local_part)
        mail_esc = ldap.filter.escape_filter_chars(email_address)
        hidden_clause = config.get("hidden_users_filter") or ""
        if aliased:
            match = f"({attrs['login']}={local_esc})"
        else:
            match = f"(|({attrs['login']}={local_esc})({attrs['mail']}={mail_esc}))"
        search_filter = f"(&{match}{hidden_clause})"

        results = conn.search_s(
            config["base_dn"],
            ldap.SCOPE_SUBTREE,
            search_filter,
            [attrs["login"], *attrs["names"]],
        )
    finally:
        conn.unbind_s()

    for _dn, entry in results:
        login_values = entry.get(attrs["login"])
        if not login_values:
            continue
        login = login_values[0].decode("utf-8")
        display_name = ""
        for name in attrs["names"]:
            values = entry.get(name) or [b""]
            display_name = values[0].decode("utf-8").strip()
            if display_name:
                break
        return login, display_name

    return None


def main():
    if len(sys.argv) != 4:
        # Wrong argv count is a script/config bug, not a lookup miss -- but
        # still exit 0 with the bare address rather than 400-ing every
        # client because of a local misconfiguration.
        fallback(sys.argv[-1] if len(sys.argv) > 1 else "")
        return

    local_part, domain, email_address = sys.argv[1:4]

    # A mail alias (DESIGN.md 3.3) resolves to its owner's login first; the
    # directory then only supplies the display name.
    owner = alias_login(email_address)

    try:
        if owner:
            found = lookup(owner, domain, email_address, aliased=True)
        else:
            found = lookup(local_part, domain, email_address)
    except Exception:
        # Connection refused, bind failure, timeout, malformed config file,
        # missing python-ldap, anything -- all fall back the same way.
        found = None

    if found is not None:
        emit(*found)
    elif owner:
        # The alias map already names the login; only the name is missing.
        emit(owner)
    else:
        fallback(email_address)


if __name__ == "__main__":
    main()
