#
# Re-reads mail domains/hostname, re-renders, validates and reloads, and
# reconciles routes (DESIGN.md 6.2) -- the same reconciliation
# configure-module/set-domains run, since a mail hostname or domain-list
# change affects exactly the same things.
#
# Payload: {"reason", "module_id", "module_uuid", "node_id"} (confirmed
# against NethServer/ns8-mail, DESIGN.md 3.2). Filtered to our tracked mail
# instance -- must tolerate the mail module being gone entirely (DESIGN.md
# 6.2: "idempotent and safe to run when the mail module ... is absent").

import json
import os
import sys

sys.path.insert(0, os.path.join(os.environ["AGENT_INSTALL_DIR"], "pypkg"))

import agent
from automx import mail, reconcile

event = json.load(sys.stdin)

rdb = agent.redis_connect(use_replica=True)
current_mail_module_id = mail.find_instance(rdb)

if current_mail_module_id is None or event.get("module_id") != current_mail_module_id:
    sys.exit(0)  # not our mail instance (or it's gone) -- nothing to do

reconcile.reconcile(rdb)
