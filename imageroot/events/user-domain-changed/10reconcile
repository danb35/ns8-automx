# Re-reads LDAP parameters and reloads (DESIGN.md 6.2). Payload:
# {"domains": [...]} (DESIGN.md 3.3) -- filtered to our bound user domain,
# and tolerant of the mail module being absent/unconfigured.

import json
import os
import sys

sys.path.insert(0, os.path.join(os.environ["AGENT_INSTALL_DIR"], "pypkg"))

import agent
from automx import mail, reconcile

event = json.load(sys.stdin)

rdb = agent.redis_connect(use_replica=True)
try:
    _module_id, _hostname, user_domain, _domain_names = mail.get_instance_info(rdb)
except (mail.MailNotFound, mail.MailNotConfigured):
    sys.exit(0)

if user_domain not in event.get("domains", []):
    sys.exit(0)  # a different user domain changed, not ours

reconcile.reconcile(rdb)
