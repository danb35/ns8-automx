# Re-render when the certificate used to sign Apple profiles changes
# (DESIGN.md 2, v2): a Let's Encrypt renewal, or the first certificate
# replacing Traefik's self-signed fallback. reload-automx restarts automx
# only if the rendered material actually differs.

import json
import os
import sys

sys.path.insert(0, os.path.join(os.environ["AGENT_INSTALL_DIR"], "pypkg"))

import agent
from automx import node, reconcile, state

event = json.load(sys.stdin)
settings = state.load_settings()
if not settings["sign_profiles"]:
    sys.exit(0)

service_host = settings.get("service_host") or node.get_node_fqdn()
if not agent.certificate_event_matches(event, service_host):
    sys.exit(0)

rdb = agent.redis_connect(use_replica=True)
reconcile.reconcile(rdb)
