#
# Re-reads LDAP parameters and reloads (DESIGN.md 6.2), same as
# user-domain-changed. This event's exact payload wasn't confirmed during
# design (DESIGN.md only names it alongside user-domain-changed), so unlike
# that handler this one doesn't try to filter by domain -- reconcile() is
# cheap enough to run unconditionally and is idempotent either way.

import os
import sys

sys.path.insert(0, os.path.join(os.environ["AGENT_INSTALL_DIR"], "pypkg"))

import agent
from automx import mail, reconcile

rdb = agent.redis_connect(use_replica=True)
try:
    mail.get_instance_info(rdb)
except (mail.MailNotFound, mail.MailNotConfigured):
    sys.exit(0)

reconcile.reconcile(rdb)
