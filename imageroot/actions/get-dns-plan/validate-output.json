{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "get-dns-plan output",
    "$id": "http://nethserver.org/json-schema/task/output/automx/get-dns-plan",
    "description": "get-dns-plan",
    "type": "object",
    "required": [
        "records"
    ],
    "additionalProperties": false,
    "properties": {
        "records": {
            "type": "array",
            "items": {
                "type": "object",
                "required": [
                    "host",
                    "type",
                    "value",
                    "suggested_ttl"
                ],
                "additionalProperties": false,
                "properties": {
                    "host": {
                        "type": "string"
                    },
                    "type": {
                        "type": "string",
                        "enum": [
                            "CNAME",
                            "SRV"
                        ]
                    },
                    "value": {
                        "type": "string"
                    },
                    "suggested_ttl": {
                        "type": "integer"
                    }
                }
            }
        }
    }
}
