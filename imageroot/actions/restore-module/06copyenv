#
# The core's restore skips state/environment and hands over the backed-up
# values here. A mail module restored in place keeps its UUID, so the binding
# still fits; if that module doesn't exist here, automx stays stopped until
# another one is chosen in Settings. A backup from before the binding has
# none, and reconcile() records one once a domain is usable.

import json
import sys

import agent

request = json.load(sys.stdin)

mail_server = request["environment"].get("MAIL_SERVER")
if mail_server:
    agent.set_env("MAIL_SERVER", mail_server)
