# DESIGN.md 7.1. GET /mobileconfig is automx's own credential-free download
# form (confirmed against src/automx/app.py, 2026-09-22); POST /mobileconfig
# is the form-urlencoded endpoint that actually returns the profile
# (fields: emailaddress required, cn optional, hidden _mobileconfig=true).
# No automx call and no state change here -- this only formats a URL and a
# static HTML snippet from state/domains.json.

import html
import json
import os
import sys

sys.path.insert(0, os.path.join(os.environ["AGENT_INSTALL_DIR"], "pypkg"))

import agent
from automx import state

data = json.load(sys.stdin)
domain = data["domain"]

domains_state = state.load_domains()
if not domains_state.get(domain, {}).get("enabled"):
    agent.set_status("validation-failed")
    json.dump(
        [{"field": "domain", "parameter": "domain", "value": domain, "error": "domain_not_enabled"}],
        fp=sys.stdout,
    )
    sys.exit(3)

escaped_domain = html.escape(domain, quote=True)
# The pattern attribute's value is a regex; "." needs its own escaping
# there in addition to (separately) being a safe HTML attribute value --
# escape order matters: escape the literal dot first, then HTML-escape.
regex_domain = html.escape(domain.replace(".", r"\."), quote=True)
url = f"https://autoconfig.{domain}/mobileconfig"

html_snippet = f"""<!-- Paste this where you want a "Download email settings" form.
     Generated by ns8-automx for domain: {escaped_domain} -->
<form action="https://autoconfig.{escaped_domain}/mobileconfig" method="post"
      style="max-width:22rem;font:14px sans-serif">
  <input type="hidden" name="_mobileconfig" value="true">
  <label for="automx-email">Your email address</label><br>
  <input id="automx-email" name="emailaddress" type="email"
         placeholder="you@{escaped_domain}" required
         pattern="[^@\\s]+@{regex_domain}"
         title="Must end in @{escaped_domain}"
         style="width:100%;box-sizing:border-box;margin:.4em 0;padding:.4em">
  <button type="submit">Download mail profile</button>
</form>
"""

json.dump({"url": url, "html_snippet": html_snippet}, fp=sys.stdout)
