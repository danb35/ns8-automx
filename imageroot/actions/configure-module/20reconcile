# Re-applies routes (host/http2https may have changed) and reloads automx
# (service_host/display_names may have changed). Route or reload failures
# aren't fatal here -- a domain can legitimately be "waiting for DNS"
# (DESIGN.md 5.6); that's surfaced through get-domains' status, not by
# failing configure-module itself.

import os
import sys

sys.path.insert(0, os.path.join(os.environ["AGENT_INSTALL_DIR"], "pypkg"))

import agent
from automx import reconcile

rdb = agent.redis_connect(use_replica=True)
reconcile.reconcile(rdb)
