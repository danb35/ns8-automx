# Create empty state so every path in etc/state-include.conf exists from
# install (a restore then overwrites these files). Domains default disabled
# (DESIGN.md decision #3): an empty domains.json already means "nothing
# enabled" via automx.state.load_domains()'s default, but writing it here
# keeps the file present for backup/restore round-tripping.

import os
import sys

sys.path.insert(0, os.path.join(os.environ["AGENT_INSTALL_DIR"], "pypkg"))
from automx import state

state.save_domains({})
state.save_settings({})
