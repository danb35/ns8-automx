import json
import os
import sys

sys.path.insert(0, os.path.join(os.environ["AGENT_INSTALL_DIR"], "pypkg"))
from automx import state

settings = state.load_settings()
domains = state.load_domains()

json.dump(
    {
        "service_host": settings["service_host"],
        "http2https": settings["http2https"],
        "display_names": settings["display_names"],
        "enabled_domain_count": sum(1 for flags in domains.values() if flags.get("enabled")),
    },
    fp=sys.stdout,
)
