{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Get automx settings",
    "$id": "http://nethserver.org/json-schema/task/output/automx/get-configuration",
    "description": "Settings plus a summary (DESIGN.md 6.1).",
    "type": "object",
    "required": [
        "service_host",
        "http2https",
        "display_names",
        "enabled_domain_count"
    ],
    "additionalProperties": false,
    "properties": {
        "service_host": {
            "type": [
                "string",
                "null"
            ]
        },
        "http2https": {
            "type": "boolean"
        },
        "display_names": {
            "type": "boolean"
        },
        "enabled_domain_count": {
            "type": "integer",
            "minimum": 0
        }
    }
}
