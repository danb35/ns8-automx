{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Get automx settings",
    "$id": "http://nethserver.org/json-schema/task/output/automx/get-configuration",
    "description": "Settings plus a summary for the Status page (DESIGN.md 6.1/7): service state, mail instance and user domain in use, dnshelper present/absent.",
    "type": "object",
    "required": [
        "service_host",
        "http2https",
        "display_names",
        "enabled_domain_count",
        "mail_server",
        "mail_servers",
        "mail_hostname",
        "user_domain",
        "dnshelper_present",
        "resolve_aliases",
        "dav_module",
        "activesync_module",
        "groupware",
        "sign_profiles",
        "signing"
    ],
    "additionalProperties": false,
    "properties": {
        "service_host": {
            "type": [
                "string",
                "null"
            ]
        },
        "http2https": {
            "type": "boolean"
        },
        "display_names": {
            "type": "boolean"
        },
        "enabled_domain_count": {
            "type": "integer",
            "minimum": 0
        },
        "mail_server": {
            "type": [
                "string",
                "null"
            ],
            "description": "MODULE_UUID of the mail module in use: the stored binding, even if that module is gone, else the one used by default. null without either."
        },
        "mail_servers": {
            "type": "array",
            "description": "The mail modules of the cluster, nearest first.",
            "items": {
                "type": "object",
                "required": [
                    "module_uuid",
                    "module_id",
                    "ui_name",
                    "hostname",
                    "user_domain",
                    "node",
                    "used_by",
                    "groupware"
                ],
                "additionalProperties": false,
                "properties": {
                    "module_uuid": {
                        "type": "string"
                    },
                    "module_id": {
                        "type": "string"
                    },
                    "ui_name": {
                        "type": "string"
                    },
                    "hostname": {
                        "type": "string"
                    },
                    "user_domain": {
                        "type": "string"
                    },
                    "node": {
                        "type": "string"
                    },
                    "used_by": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "description": "Another automx instance bound to this mail module, if any."
                    },
                    "groupware": {
                        "type": "array",
                        "description": "Groupware modules usable with this mail module; same items as the top-level groupware.",
                        "items": {
                            "type": "object"
                        }
                    }
                }
            }
        },
        "mail_hostname": {
            "type": [
                "string",
                "null"
            ],
            "description": "null when no mail module instance is found or configured yet"
        },
        "user_domain": {
            "type": [
                "string",
                "null"
            ]
        },
        "dnshelper_present": {
            "type": "boolean"
        },
        "dav_module": {
            "type": [
                "string",
                "null"
            ]
        },
        "activesync_module": {
            "type": [
                "string",
                "null"
            ]
        },
        "groupware": {
            "type": "array",
            "description": "Groupware modules that can provide CalDAV/CardDAV or ActiveSync for the mail instance (automx/groupware.py); empty without a configured mail instance.",
            "items": {
                "type": "object",
                "required": [
                    "module_id",
                    "kind",
                    "host",
                    "dav_url",
                    "activesync_url"
                ],
                "additionalProperties": false,
                "properties": {
                    "module_id": {
                        "type": "string"
                    },
                    "kind": {
                        "type": "string",
                        "enum": [
                            "nextcloud",
                            "sogo",
                            "webtop"
                        ]
                    },
                    "host": {
                        "type": "string"
                    },
                    "dav_url": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "activesync_url": {
                        "type": [
                            "string",
                            "null"
                        ]
                    }
                }
            }
        },
        "resolve_aliases": {
            "type": "boolean"
        },
        "sign_profiles": {
            "type": "boolean"
        },
        "signing": {
            "type": [
                "object",
                "null"
            ],
            "description": "Outcome of the last render with signing on (null when off or not rendered yet): the certificate used for the service host, why signing was skipped (problem), and whether this node's trust store trusts it (null if unknown).",
            "required": [
                "host",
                "certificate_type",
                "problem",
                "trusted"
            ],
            "additionalProperties": false,
            "properties": {
                "host": {
                    "type": "string"
                },
                "certificate_type": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "enum": [
                        "internal",
                        "custom",
                        "selfsigned",
                        null
                    ]
                },
                "problem": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "enum": [
                        "no_certificate",
                        "not_available",
                        "unreadable",
                        "not_rsa",
                        "key_too_small",
                        "key_mismatch",
                        "expired",
                        "no_digital_signature",
                        null
                    ]
                },
                "trusted": {
                    "type": [
                        "boolean",
                        "null"
                    ]
                }
            }
        }
    }
}
