{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Get automx settings",
    "$id": "http://nethserver.org/json-schema/task/output/automx/get-configuration",
    "description": "Settings plus a summary for the Status page (DESIGN.md 6.1/7): service state, mail instance and user domain in use, dnshelper present/absent.",
    "type": "object",
    "required": [
        "service_host",
        "http2https",
        "display_names",
        "enabled_domain_count",
        "mail_hostname",
        "user_domain",
        "dnshelper_present",
        "dav_module",
        "activesync_module",
        "groupware"
    ],
    "additionalProperties": false,
    "properties": {
        "service_host": {
            "type": [
                "string",
                "null"
            ]
        },
        "http2https": {
            "type": "boolean"
        },
        "display_names": {
            "type": "boolean"
        },
        "enabled_domain_count": {
            "type": "integer",
            "minimum": 0
        },
        "mail_hostname": {
            "type": [
                "string",
                "null"
            ],
            "description": "null when no mail module instance is found or configured yet"
        },
        "user_domain": {
            "type": [
                "string",
                "null"
            ]
        },
        "dnshelper_present": {
            "type": "boolean"
        },
        "dav_module": {
            "type": [
                "string",
                "null"
            ]
        },
        "activesync_module": {
            "type": [
                "string",
                "null"
            ]
        },
        "groupware": {
            "type": "array",
            "description": "Groupware modules that can provide CalDAV/CardDAV or ActiveSync for the mail instance (automx/groupware.py); empty without a configured mail instance.",
            "items": {
                "type": "object",
                "required": [
                    "module_id",
                    "kind",
                    "host",
                    "dav_url",
                    "activesync_url"
                ],
                "additionalProperties": false,
                "properties": {
                    "module_id": {
                        "type": "string"
                    },
                    "kind": {
                        "type": "string",
                        "enum": [
                            "nextcloud",
                            "sogo",
                            "webtop"
                        ]
                    },
                    "host": {
                        "type": "string"
                    },
                    "dav_url": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "activesync_url": {
                        "type": [
                            "string",
                            "null"
                        ]
                    }
                }
            }
        }
    }
}
