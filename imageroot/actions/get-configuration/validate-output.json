{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Get automx settings",
    "$id": "http://nethserver.org/json-schema/task/output/automx/get-configuration",
    "description": "Settings plus a summary for the Status page (DESIGN.md 6.1/7): service state, mail instance and user domain in use, dnshelper present/absent.",
    "type": "object",
    "required": [
        "service_host",
        "http2https",
        "display_names",
        "enabled_domain_count",
        "mail_hostname",
        "user_domain",
        "dnshelper_present"
    ],
    "additionalProperties": false,
    "properties": {
        "service_host": {
            "type": [
                "string",
                "null"
            ]
        },
        "http2https": {
            "type": "boolean"
        },
        "display_names": {
            "type": "boolean"
        },
        "enabled_domain_count": {
            "type": "integer",
            "minimum": 0
        },
        "mail_hostname": {
            "type": [
                "string",
                "null"
            ],
            "description": "null when no mail module instance is found or configured yet"
        },
        "user_domain": {
            "type": [
                "string",
                "null"
            ]
        },
        "dnshelper_present": {
            "type": "boolean"
        }
    }
}
