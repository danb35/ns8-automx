{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "get-domains output",
    "$id": "http://nethserver.org/json-schema/task/output/automx/get-domains",
    "description": "Mail domains merged with stored enable flags, route status, and DNS status per record (DESIGN.md 6.1).",
    "type": "object",
    "required": [
        "dnshelper_present",
        "domains"
    ],
    "additionalProperties": false,
    "definitions": {
        "domain-settings": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "display_names": {
                    "type": "boolean"
                },
                "resolve_aliases": {
                    "type": "boolean"
                },
                "dav_module": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "activesync_module": {
                    "type": [
                        "string",
                        "null"
                    ]
                }
            }
        }
    },
    "properties": {
        "dnshelper_present": {
            "type": "boolean"
        },
        "domains": {
            "type": "array",
            "items": {
                "type": "object",
                "required": [
                    "domain",
                    "enabled",
                    "orphaned",
                    "overrides",
                    "settings",
                    "route_status",
                    "dns"
                ],
                "additionalProperties": false,
                "properties": {
                    "domain": {
                        "type": "string"
                    },
                    "enabled": {
                        "type": "boolean"
                    },
                    "orphaned": {
                        "type": "boolean",
                        "description": "In state/domains.json but no longer among the mail module's domains"
                    },
                    "overrides": {
                        "description": "The settings this domain overrides (set-domain-settings); a setting not listed follows the instance-wide default",
                        "$ref": "#/definitions/domain-settings"
                    },
                    "settings": {
                        "description": "The settings that apply to this domain: its overrides on top of the instance-wide defaults (DESIGN.md 12)",
                        "allOf": [
                            {
                                "$ref": "#/definitions/domain-settings"
                            }
                        ],
                        "required": [
                            "display_names",
                            "resolve_aliases",
                            "dav_module",
                            "activesync_module"
                        ]
                    },
                    "route_status": {
                        "type": "string",
                        "enum": [
                            "configured",
                            "not_configured",
                            "waiting_for_dns"
                        ]
                    },
                    "dns": {
                        "type": "object",
                        "required": [
                            "managed",
                            "zone",
                            "allowed",
                            "records"
                        ],
                        "additionalProperties": false,
                        "properties": {
                            "managed": {
                                "type": "boolean",
                                "description": "true if dnshelper covers this domain's zone"
                            },
                            "zone": {
                                "type": [
                                    "string",
                                    "null"
                                ]
                            },
                            "allowed": {
                                "type": [
                                    "boolean",
                                    "null"
                                ],
                                "description": "null when dnshelper is absent or the zone isn't managed"
                            },
                            "records": {
                                "type": "array",
                                "items": {
                                    "type": "object",
                                    "required": [
                                        "host",
                                        "type",
                                        "value",
                                        "status"
                                    ],
                                    "additionalProperties": true,
                                    "properties": {
                                        "host": {
                                            "type": "string"
                                        },
                                        "type": {
                                            "type": "string",
                                            "enum": [
                                                "CNAME",
                                                "SRV"
                                            ]
                                        },
                                        "value": {
                                            "type": "string"
                                        },
                                        "status": {
                                            "type": "string",
                                            "enum": [
                                                "ok",
                                                "missing",
                                                "conflict",
                                                "not_permitted",
                                                "unknown"
                                            ]
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
